{
  "typescript": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  },
  "tailwindcss": {
    "command": "tailwindcss-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": { ".css": "css", ".html": "html" }
  },
  "csharp": {
    "command": "omnisharp",
    "args": ["-lsp"],
    "startupTimeout": 60000,
    "extensionToLanguage": { ".cs": "csharp", ".csx": "csharp" }
  },
  "python": {
    "command": "pyright-langserver",
    "args": ["--stdio"],
    "extensionToLanguage": { ".py": "python", ".pyi": "python" }
  },
  "bash": {
    "command": "bash-language-server",
    "args": ["start"],
    "extensionToLanguage": { ".sh": "shellscript", ".bash": "shellscript" }
  },
  "yaml": {
    "command": "yaml-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": { ".yaml": "yaml", ".yml": "yaml" }
  },
  "json": {
    "command": "vscode-json-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": { ".json": "json", ".jsonc": "jsonc" }
  },
  "html": {
    "command": "vscode-html-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": { ".htm": "html" }
  },
  "css": {
    "command": "vscode-css-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": { ".scss": "scss", ".less": "less" }
  },
  "markdown": {
    "command": "marksman",
    "args": ["server"],
    "extensionToLanguage": { ".md": "markdown" }
  },
  "terraform": {
    "command": "terraform-ls",
    "args": ["serve"],
    "extensionToLanguage": { ".tf": "terraform", ".tfvars": "terraform-vars" }
  }
}
